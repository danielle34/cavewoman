# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store

# --- Secrets ---
.env

# --- Generated analysis output ---------------------------------------------
# The pipeline writes tables, LaTeX tables, figures, logs, and stats into this tree.
analysis_outputs/
analysis/analysis_outputs/

# --- Generated results ------------------------------------------------------
# Anything a run produces under results/. The shipped tables and samples are
# tracked explicitly by the negations below; everything else is your output.
results/*
!results/README.md
!results/tables/
!results/samples/

# Per-cell generations from your own runs, wherever they land.
*_input/
*_output/
