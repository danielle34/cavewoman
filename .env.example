# Copy this file to `.env` and fill in the keys for the providers you
# plan to use. `experiments/run_experiment_api.py` loads this at startup
# via python-dotenv.

# OpenAI (gpt-4o, gpt-5.4)
OPENAI_API_KEY=your_openai_key_here

# Anthropic (claude-haiku-4-5, claude-sonnet-4-6)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Azure-hosted Kimi-K2.6: both key and endpoint are required.
# AZURE_KIMI_ENDPOINT is your Azure resource URL, e.g.
# https://<your-resource>.cognitiveservices.azure.com/
AZURE_KIMI_API_KEY=your_azure_kimi_key_here
AZURE_KIMI_ENDPOINT=your_azure_kimi_endpoint_here
